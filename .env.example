# All VITE_ values are bundled into the browser. Only put PUBLIC values here.
# Safe to expose: store domain, API version, PUBLIC Storefront access token.
# NEVER put Admin API tokens or secrets in any VITE_ variable.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_API_VERSION=2025-01
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_token
# Public contact address used by the Contact form (opens the visitor's email app).
VITE_CONTACT_EMAIL=hello@example.com
# Optional analytics (public IDs). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Optional: "all wraps" collection handle so Shop All gets filters.
VITE_SHOP_ALL_COLLECTION=
# Optional: override the newsletter endpoint (default /api/newsletter).
VITE_NEWSLETTER_ENDPOINT=

# ---- SERVER-ONLY (set in your host's dashboard; never prefix with VITE_) ----
# Used by api/newsletter.ts. Admin API scope needed: write_customers.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
ALLOWED_ORIGIN=https://your-domain.com
