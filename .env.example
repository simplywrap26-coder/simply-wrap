# All VITE_ values are bundled into the browser. Only put PUBLIC values here.
# Safe to expose: store domain, API version, PUBLIC Storefront access token.
# NEVER put Admin API tokens or secrets in any VITE_ variable.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_API_VERSION=2025-01
VITE_SHOPIFY_STOREFRONT_TOKEN=59a96f47fe7e8f47dc8b9902db491743
# Public contact address used by the Contact form (opens the visitor's email app).
VITE_CONTACT_EMAIL=simplywrap26@gmail.com
# Optional analytics (public IDs). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=
